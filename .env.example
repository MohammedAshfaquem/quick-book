# ─────────────────────────────────────────────
# Django Core
# ─────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ─────────────────────────────────────────────
# Module Feature Toggles
# ─────────────────────────────────────────────
EVENT_MODULE=True
BOOKING_MODULE=True
VENDOR_MODULE=True
REFERRAL_MODULE=True

# ─────────────────────────────────────────────
# Payment Gateway
# ─────────────────────────────────────────────
ENABLE_PAYMENT_GATEWAY=False

# ─────────────────────────────────────────────
# Booking Settings
# ─────────────────────────────────────────────
# Reservation hold timeout in minutes before a pending booking expires
BOOKING_TIME_MINUTES=15
